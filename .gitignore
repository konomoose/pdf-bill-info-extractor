
# Python virtual environments
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]
.pytest_cache/

# Original institution source statements
source_input/**/*
!source_input/**/
!source_input/**/.gitkeep

# Security-removed working statements
editable_input/**/*
!editable_input/**/
!editable_input/**/.gitkeep

# Redacted working statements
redacted_input/**/*
!redacted_input/**/
!redacted_input/**/.gitkeep

# Generated extraction output
csv_output/**/*
!csv_output/**/
!csv_output/**/.gitkeep

# Local regression-test statements
tests/input/**/*
!tests/input/**/
!tests/input/**/.gitkeep

# Manually verified reference CSV files
tests/reference_output/**/*
!tests/reference_output/**/
!tests/reference_output/**/.gitkeep

# Output created by automated tests
tests/output/**/*
!tests/output/**/
!tests/output/**/.gitkeep

# Ghostscript installer
ghostscript-gs*.exe

# Logs and temporary files
*.log
temp/
tmp/

# Local configuration overrides
.env
config/*.local.json
config/profiles/*.local.json

# Editors and Windows files
.vscode/
.idea/
Thumbs.db
desktop.ini
